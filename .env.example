APP_ENV=development            # development | test | e2e
LOG_LEVEL=INFO                 # Python logging level for the backend
FRONTEND_URL=http://localhost:5173   # Origin of the Vite dev server
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/email_assistant   # Dev database
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/email_assistant_test   # Test database used by pytest
